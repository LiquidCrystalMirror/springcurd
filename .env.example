# ==================== 数据库配置 ====================
# docker-compose 默认数据库名: springbootdemo
DB_URL=jdbc:mysql://localhost:3306/springbootdemo?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# ==================== Redis 配置 ====================
REDIS_ADDRESS=redis://127.0.0.1:6379
REDIS_DATABASE=0
REDIS_POOL_SIZE=64

# ==================== RabbitMQ 配置 ====================
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# ==================== JWT 配置 ====================
# ⚠️ 生产环境请生成随机密钥替换
JWT_SECRET=your-jwt-secret-change-me-in-production
JWT_EXPIRATION=86400000

# ==================== MD5 配置（仅旧密码兼容） ====================
MD5_SALT=your-md5-salt

<?xml version="1.0" encoding="UTF-8"?>
<configuration scan="true" scanPeriod="60 seconds" debug="false">

    <!-- 日志存放根目录 -->
    <property name="LOG_HOME" value="logs"/>
    
    <!-- 日志输出格式 -->
    <property name="LOG_PATTERN" 
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{50} - [Category:%X{logCategory}] [BizNo:%X{bizNo}] %msg%n"/>

    <!-- 控制台输出 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== Logger配置 ==================== -->
    
    <!-- 严重错误日志 Appender - 独立存储需要人工介入的错误 -->
    <appender name="CRITICAL" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_HOME}/critical/critical.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_HOME}/critical/critical.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>90</maxHistory>
            <totalSizeCap>5GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>${LOG_PATTERN}</pattern>
            <charset>UTF-8</charset>
        </encoder>
        <!-- 只记录包含严重关键词的 ERROR 日志 -->
        <filter class="ch.qos.logback.core.filter.EvaluatorFilter">
            <evaluator class="ch.qos.logback.classic.boolex.JaninoEventEvaluator">
                <expression>
                    return level == 40 &amp;&amp; 
                           (message != null &amp;&amp; 
                            (message.contains("严重") || 
                             message.contains("需人工介入") || 
                             message.contains("数据不一致")));
                </expression>
            </evaluator>
            <OnMatch>ACCEPT</OnMatch>
            <OnMismatch>DENY</OnMismatch>
        </filter>
    </appender>
    
    <!-- 使用 SiftingAppender 根据 MDC 中的 logCategory 动态路由日志 -->
    <appender name="SIFT" class="ch.qos.logback.classic.sift.SiftingAppender">
        <!-- 根据 MDC 中的 logCategory 进行分流 -->
        <discriminator>
            <key>logCategory</key>
            <defaultValue>unknown</defaultValue>
        </discriminator>
        <sift>
            <!-- 为每个 category 创建独立的 appender -->
            <appender name="FILE-${logCategory}" class="ch.qos.logback.core.rolling.RollingFileAppender">
                <file>${LOG_HOME}/${logCategory}/${logCategory}.log</file>
                <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
                    <fileNamePattern>${LOG_HOME}/${logCategory}/${logCategory}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
                    <maxFileSize>100MB</maxFileSize>
                    <maxHistory>30</maxHistory>
                    <totalSizeCap>10GB</totalSizeCap>
                </rollingPolicy>
                <encoder>
                    <pattern>${LOG_PATTERN}</pattern>
                    <charset>UTF-8</charset>
                </encoder>
            </appender>
        </sift>
    </appender>

    <!-- StructuredLogger 使用 SiftingAppender 动态路由 -->
    <logger name="org.example.springbootdemo.util.StructuredLogger" level="INFO" additivity="false">
        <appender-ref ref="SIFT"/>
        <appender-ref ref="CRITICAL"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- 根日志级别 -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.springbootdemo.mapper.OrderDetailMapper">

    <resultMap id="BaseResultMap" type="org.example.springbootdemo.entity.OrderDetail">
        <id property="id" column="id" jdbcType="BIGINT"/>
        <result property="orderNo" column="order_no" jdbcType="VARCHAR"/>
        <result property="platformId" column="platform_id" jdbcType="VARCHAR"/>
        <result property="productId" column="product_id" jdbcType="BIGINT"/>
        <result property="quantity" column="quantity" jdbcType="INTEGER"/>
        <result property="status" column="status" jdbcType="TINYINT"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
    </resultMap>

    <!-- 根据主键查询 -->
    <select id="queryById" resultMap="BaseResultMap">
        SELECT id, order_no, platform_id, product_id, quantity, status, create_time, update_time
        FROM order_detail
        WHERE id = #{id}
    </select>

    <!-- 分页查询 -->
    <select id="find" resultMap="BaseResultMap" parameterType="org.example.springbootdemo.query.OrderQuery">
        SELECT id, order_no, platform_id, product_id, quantity, status, create_time, update_time
        FROM order_detail
        <where>
            <if test="orderNo != null and orderNo != ''">
                AND order_no = #{orderNo}
            </if>
            <if test="platformId != null and platformId != ''">
                AND platform_id = #{platformId}
            </if>
            <if test="productId != null">
                AND product_id = #{productId}
            </if>
            <if test="quantity != null">
                AND quantity = #{quantity}
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <!-- 插入（MyBatis-Plus 的雪花ID会自动赋值给 id） -->
    <insert id="insert" parameterType="org.example.springbootdemo.entity.OrderDetail">
        INSERT INTO order_detail (id, order_no, platform_id, product_id, quantity, status, create_time, update_time)
        VALUES (#{id}, #{orderNo}, #{platformId}, #{productId}, #{quantity}, #{status}, #{createTime}, #{updateTime})
    </insert>

    <!-- 更新 -->
    <update id="update" parameterType="org.example.springbootdemo.entity.OrderDetail">
        UPDATE order_detail
        <set>
            <if test="orderNo != null and orderNo != ''">order_no = #{orderNo},</if>
            <if test="platformId != null and platformId != ''">platform_id = #{platformId},</if>
            <if test="productId != null">product_id = #{productId},</if>
            <if test="quantity != null">quantity = #{quantity},</if>
            <if test="status != null">status = #{status},</if>
            <if test="updateTime != null">update_time = #{updateTime},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 根据主键删除 -->
    <delete id="deleteById">
        DELETE FROM order_detail WHERE id = #{id}
    </delete>

</mapper>